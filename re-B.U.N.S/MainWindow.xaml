<Window x:Class="ReBuns.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="re-B.U.N.S — GTA 6 Control Scheme &amp; Keyboard/Mouse Remapper"
        Icon="pack://application:,,,/re-B.U.N.S.ico"
        Height="860" Width="1380" MinWidth="960" MinHeight="600"
        Background="{StaticResource GtaBg}"
        Foreground="{StaticResource Fg}"
        TextElement.Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Main Application Content -->
        <DockPanel x:Name="MainContentRoot">
            <!-- Top GTA 6 Settings Header (Responsive: never clips SETTINGS on smaller windows) -->
            <Border DockPanel.Dock="Top" Padding="24,14,24,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/Logo.png" Width="56" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SettingsHeaderTitle" Text="SETTINGS" FontSize="24" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#3D1F4C" BorderBrush="#754A84" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="v1.6.6" FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FgProc" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,2,8,2" FontSize="11.5"/>
                        <!-- Xbox / PlayStation Controller Switcher -->
                        <Border Background="#2B1638" BorderBrush="#754A84" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,2,6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="XboxToggleBtn" Content="🎮 Xbox" Click="XboxToggle_Click" FontWeight="ExtraBold" FontSize="11" Padding="7,3" Background="#107C10" BorderBrush="#3DDC97" Foreground="White"/>
                                <Button x:Name="PsToggleBtn" Content="🎮 PlayStation" Click="PsToggle_Click" FontWeight="Bold" FontSize="11" Padding="7,3" Background="Transparent" BorderBrush="Transparent" Foreground="#C8A2C8"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DriverBtn" Content="✓ ViGEmBus Ready" Click="DriverBtn_Click" FontSize="11.5" Padding="8,4" Margin="0,2,6,2"/>
                        <Button x:Name="UpdateBtn" Content="⟳ Check Updates" Click="UpdateBtn_Click" FontSize="11.5" Padding="8,4" Margin="0,2,6,2"/>
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" Width="125" Margin="0,2,6,2" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" ToolTip="Select Language"/>
                        <Border x:Name="StatusPill" CornerRadius="4" Padding="10,5" Background="#3B1D47" BorderBrush="#754A84" BorderThickness="1" Margin="0,2,6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="STOPPED" Foreground="White" FontWeight="Bold" FontSize="11.5"/>
                        </Border>
                        <Button x:Name="StartBtn" Content="▶  START VIRTUAL PAD" Click="StartBtn_Click" FontWeight="ExtraBold" FontSize="12" Padding="14,6" Margin="0,2,0,2"
                                Background="#1E8A5A" BorderBrush="#3DDC97" Foreground="White"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Bottom GTA 6 Prompts Footer -->
            <Border DockPanel.Dock="Bottom" Padding="24,8,24,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="⟳ CYCLE TAP / HOLD VIEW" Click="CycleHoldView_Click" FontSize="11" FontWeight="Bold" Padding="9,5" Margin="0,0,6,0"/>
                        <Button Content="ⓨ COMPARE ALL 4 PRESETS" Click="OpenLayoutPicker_Click" FontSize="11" FontWeight="Bold" Padding="9,5" Margin="0,0,6,0"/>
                        <Button Content="ⓧ RESTORE DEFAULT" Click="ResetGta_Click" FontSize="11" FontWeight="Bold" Padding="9,5"/>
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateStatusText" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="Bold" Margin="12,0,0,0"/>
                        <TextBlock x:Name="Footer" Foreground="{StaticResource Dim}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="[WINDOWS KEY] = Pause / Play Virtual Pad   ·   [CTRL + ALT + DELETE] = Stop Virtual Pad"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Main GTA 6 Settings Tab Control -->
            <Grid Margin="24,0,24,0">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- TAB 1: CONTROL SCHEME -->
                    <TabItem Header="CONTROL SCHEME">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Scrollable CONTROL SCHEME + PREVIEW + QUICK BIND (never cuts off on small windows!) -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Margin="0,4,10,0">
                                <StackPanel Background="Transparent" Margin="0,0,10,16">
                                    <TextBlock Text="CONTROL SCHEME" FontSize="18" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,6"/>

                                    <!-- Controller Layout Mode Switcher -->
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="CONTROLLER EMULATION" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="SchemeXboxBtn" Content="🎮 Xbox" Click="XboxToggle_Click" FontWeight="Bold" FontSize="11" Padding="7,3" Margin="0,0,4,0"/>
                                            <Button x:Name="SchemePsBtn" Content="🎮 PlayStation" Click="PsToggle_Click" FontWeight="Bold" FontSize="11" Padding="7,3"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- White Gradient Selector Box ("★ ReBuns   1 / 4   <  >") -->
                                    <Border Height="46" CornerRadius="2" Cursor="Hand" MouseLeftButtonDown="SchemeBox_Click">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#F3EDF6" Offset="0.58"/>
                                                <GradientStop Color="#9B7CA6" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <DockPanel Margin="14,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="SchemeIndexText" Text="1  /  4" Foreground="#1A0C24" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="❮" Click="PrevScheme_Click" Width="28" Height="28" Padding="0" Background="#2B1638" BorderBrush="#2B1638" Foreground="White" FontWeight="ExtraBold" FontSize="13"/>
                                                <Button Content="❯" Click="NextScheme_Click" Width="28" Height="28" Padding="0" Background="#2B1638" BorderBrush="#2B1638" Foreground="White" FontWeight="ExtraBold" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SchemeNameText" Text="★ re-B.U.N.S" Foreground="#1A0C24" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Tap vs Hold Schematic View Switcher -->
                                    <TextBlock Text="SCHEMATIC ACTION VIEW" FontSize="12.5" FontWeight="ExtraBold" Foreground="{StaticResource Dim}" Margin="0,14,0,6"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <Button x:Name="ViewBothBtn" Content="TAP + HOLD" Click="HoldView_Click" Tag="0" FontSize="11" FontWeight="ExtraBold" Padding="6,6"/>
                                        <Button x:Name="ViewTapBtn" Content="TAP ONLY" Click="HoldView_Click" Tag="1" FontSize="11" FontWeight="ExtraBold" Padding="6,6"/>
                                        <Button x:Name="ViewHoldBtn" Content="◎ HOLD ONLY" Click="HoldView_Click" Tag="2" FontSize="11" FontWeight="ExtraBold" Padding="6,6"/>
                                    </UniformGrid>

                                    <!-- PREVIEW list matching GTA 6 screenshot -->
                                    <TextBlock Text="PREVIEW" FontSize="18" FontWeight="ExtraBold" Foreground="White" Margin="0,2,0,6"/>
                                    <StackPanel x:Name="PreviewList"/>

                                    <!-- Selected Action / Button Keybind Inspector -->
                                    <Border Background="#261230" BorderBrush="#724880" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SELECTED CONTROLLER ACTION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock x:Name="SelName" Text="Click any action or button →" FontSize="15" FontWeight="ExtraBold" Foreground="White" Margin="0,3,0,2" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="SelSub" Text="Click any callout row or controller button to customize its keyboard/mouse key or Tap/Hold/Double-Tap mode." FontSize="11.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <ItemsControl x:Name="SelKeys"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="AddKeyBtn" Content="＋ BIND KEY / MOUSE" Click="AddKey_Click" IsEnabled="False" FontWeight="ExtraBold" FontSize="11.5"/>
                                                <ComboBox x:Name="NewBindActCombo" Grid.Column="1" Width="112" Margin="4,2,2,2" ToolTip="Trigger mode for newly added key">
                                                    <ComboBoxItem Content="1:1 Tap &amp; Hold" IsSelected="True"/>
                                                    <ComboBoxItem Content="Single Tap"/>
                                                    <ComboBoxItem Content="Long Hold (◎)"/>
                                                    <ComboBoxItem Content="Double Tap"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Vertical Divider Line matching screenshot -->
                            <Border Grid.Column="1" Background="#623870" Width="1.5" Margin="0,6,0,6"/>

                            <!-- Right Area: GTA 6 Controller Schematic Canvas -->
                            <Viewbox Grid.Column="2" Stretch="Uniform" Margin="12,0,0,0">
                                <Canvas x:Name="Pad" Width="1080" Height="560"/>
                            </Viewbox>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: CONTROLLER & MOUSE SETTINGS -->
                    <TabItem Header="CONTROLLER &amp; MOUSE">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                <StackPanel x:Name="SettingsPanel" Background="Transparent" Margin="4,0,16,16" MaxWidth="780" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                            <Border Grid.Column="1" Background="#2A1435" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="LIVE VIRTUAL CONTROLLER TELEMETRY" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Canvas Width="96" Height="96" Background="#1D0E26" ClipToBounds="True">
                                                <Ellipse Width="92" Height="92" Canvas.Left="2" Canvas.Top="2" Stroke="#6D437A" StrokeThickness="1"/>
                                                <Line X1="48" Y1="4" X2="48" Y2="92" Stroke="#3D204B" StrokeThickness="1"/>
                                                <Line X1="4" Y1="48" X2="92" Y2="48" Stroke="#3D204B" StrokeThickness="1"/>
                                                <Ellipse x:Name="LsDot" Width="10" Height="10" Fill="#3DDC97" Canvas.Left="43" Canvas.Top="43"/>
                                            </Canvas>
                                            <TextBlock x:Name="LsText" Text="LS: 0, 0" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Canvas Width="96" Height="96" Background="#1D0E26" ClipToBounds="True">
                                                <Ellipse Width="92" Height="92" Canvas.Left="2" Canvas.Top="2" Stroke="#6D437A" StrokeThickness="1"/>
                                                <Line X1="48" Y1="4" X2="48" Y2="92" Stroke="#3D204B" StrokeThickness="1"/>
                                                <Line X1="4" Y1="48" X2="92" Y2="48" Stroke="#3D204B" StrokeThickness="1"/>
                                                <Ellipse x:Name="RsDot" Width="10" Height="10" Fill="#F687B3" Canvas.Left="43" Canvas.Top="43"/>
                                            </Canvas>
                                            <TextBlock x:Name="RsText" Text="RS: 0, 0" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="LiveText" Foreground="White" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: KEYBOARD & MOUSE SCHEMATIC -->
                    <TabItem Header="KEYBOARD &amp; MOUSE">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#24122E" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="KbCanvas" Width="960" Height="470"/>
                                </Viewbox>
                            </Border>
                            <Border Grid.Column="1" Background="#2A1435" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="KEY / MOUSE INSPECTOR" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock x:Name="KbSelTitle" Text="Click any key or mouse button" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,4" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="KbSelSub" Text="Configure single tap, long hold (◎), or double-tap actions for any key." FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <StackPanel x:Name="KbInspectorPanel" Background="Transparent"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: ALL BINDINGS TABLE -->
                    <TabItem Header="ALL BINDINGS">
                        <DockPanel Margin="0,16,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="16,0,0,0">
                                    <TextBlock Text="Scenario:" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="ScenarioFilterCombo" Width="165" Margin="0,0,12,0" SelectionChanged="ScenarioFilterCombo_SelectionChanged"/>
                                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBox x:Name="FilterBox" Width="180" TextChanged="FilterBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="＋ ADD BINDING" Click="AddBinding_Click" FontWeight="Bold"/>
                                    <Button Content="✕ REMOVE SELECTED" Click="RemoveBinding_Click" FontWeight="Bold"/>
                                    <TextBlock Text="   Tip: Set 'Key Activator' (Regular / SingleTap / LongHold / DoubleTap) &amp; 'Output Mode' (Hold / TapPulse / HoldPulse)."
                                               Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="6,0,12,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="#24122E" RowBackground="#2F183B" AlternatingRowBackground="#381D46"
                                      Foreground="{StaticResource Fg}" GridLinesVisibility="None" BorderBrush="#6D437A" BorderThickness="1" RowHeight="38"/>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 5: PROFILES & UPDATES -->
                    <TabItem Header="PROFILES &amp; UPDATES">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A1435" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,14,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="PROFILES &amp; GTA 6 SCHEMES" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,8"/>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="🎮  OPEN 4-PRESET COMPARISON" Click="OpenLayoutPicker_Click" FontWeight="Bold"/>
                                        <Button Content="🔄  RESTORE CURRENT SCHEME DEFAULT" Click="ResetGta_Click"/>
                                        <UniformGrid Columns="3" Margin="0,4,0,2">
                                            <Button Content="+ Custom" Click="New_Click"/>
                                            <Button Content="Clone" Click="Dup_Click"/>
                                            <Button Content="Delete" Click="Del_Click"/>
                                        </UniformGrid>
                                        <Button Content="📥  IMPORT CONFIG FILE" Click="Import_Click"/>
                                        <Button Content="📂  OPEN PROFILES FOLDER" Click="Folder_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="ProfileList" Background="#1E0E26" BorderBrush="#5A3366" BorderThickness="1" Foreground="{StaticResource Fg}"
                                             SelectionChanged="ProfileList_SelectionChanged" DisplayMemberPath="Name" FontSize="13"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#2A1435" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="8" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <StackPanel x:Name="UpdatesPanel" Background="Transparent" HorizontalAlignment="Stretch"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>

        <!-- Launch Splash Animation Overlay -->
        <Border x:Name="LaunchOverlay" IsHitTestVisible="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#471E4A" Offset="0.0"/>
                    <GradientStop Color="#281133" Offset="0.55"/>
                    <GradientStop Color="#14081C" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Animated Neon Pulse Rings -->
                <Ellipse x:Name="SplashRing2" Width="310" Height="310" Stroke="#33F687B3" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale" ScaleX="0.7" ScaleY="0.7"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="SplashRing1" Width="220" Height="220" Stroke="#553DDC97" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale" ScaleX="0.8" ScaleY="0.8"/></Ellipse.RenderTransform>
                </Ellipse>

                <StackPanel x:Name="SplashCard" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform><ScaleTransform x:Name="SplashCardScale" ScaleX="0.88" ScaleY="0.88"/></StackPanel.RenderTransform>
                    <Image Source="pack://application:,,,/Logo.png" Width="300" Height="205" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="re-B.U.N.S" FontSize="36" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="GTA 6 KEYBOARD &amp; MOUSE CONTROLLER ENGINE" FontSize="13.5" FontWeight="Bold" Foreground="#F687B3" HorizontalAlignment="Center" Margin="0,6,0,22"/>
                    <Border Width="380" Height="7" Background="#2B1438" BorderBrush="#6D437A" BorderThickness="1" CornerRadius="4" Padding="1">
                        <Border x:Name="SplashBarFill" Width="10" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F687B3" Offset="0.0"/>
                                    <GradientStop Color="#3DDC97" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock x:Name="SplashStatusText" Text="INITIALIZING VIGEMBUS VIRTUAL CONTROLLER..." FontSize="11.5" FontWeight="Bold" Foreground="#D6C4DE" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
