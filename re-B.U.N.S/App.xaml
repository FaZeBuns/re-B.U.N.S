<Application x:Class="ReBuns.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <LinearGradientBrush x:Key="GtaBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#72386C" Offset="0.0"/>
            <GradientStop Color="#532856" Offset="0.52"/>
            <GradientStop Color="#291435" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- GTA 6 Vice City Gradient for Custom ScrollBars -->
        <LinearGradientBrush x:Key="GtaScrollThumb" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF7BAC" Offset="0.0"/>
            <GradientStop Color="#B566FF" Offset="0.5"/>
            <GradientStop Color="#3DDC97" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GtaScrollThumbHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFA3C7" Offset="0.0"/>
            <GradientStop Color="#CF96FF" Offset="0.5"/>
            <GradientStop Color="#6FF5B8" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Bg" Color="#291435"/>
        <SolidColorBrush x:Key="Panel" Color="#351B42"/>
        <SolidColorBrush x:Key="Panel2" Color="#442352"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#724880"/>
        <SolidColorBrush x:Key="Accent" Color="#F687B3"/>
        <SolidColorBrush x:Key="Mint" Color="#3DDC97"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1E8A5A"/>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkText" Color="#1A0C24"/>
        <SolidColorBrush x:Key="Dim" Color="#E0D0E8"/>

        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#24112E"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#724880"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <!-- High-Contrast ComboBox & ComboBoxItem Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A0C24"/>
            <Setter Property="Background" Value="#F3EDF6"/>
            <Setter Property="BorderBrush" Value="#724880"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A0C24"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Custom GTA 6 Gradient ScrollBar Thumb -->
        <Style x:Key="GtaScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd"
                                Background="{StaticResource GtaScrollThumb}"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource GtaScrollThumbHover}"/>
                                <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible RepeatButton for Track Page Up/Down -->
        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom GTA 6 Gradient ScrollBar (Replaces ugly Windows native gray scrollbars everywhere) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#22102C" BorderBrush="#4E2A5C" BorderThickness="1" CornerRadius="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GtaScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="#22102C" BorderBrush="#4E2A5C" BorderThickness="1" CornerRadius="5">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource GtaScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GTA 6 Button Style: Dynamically switches text color when background is white vs dark -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D1F4C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7A4E8A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="#1A0C24"/>
                                <Setter Property="Foreground" Value="#1A0C24"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E8D8F0"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="#1A0C24"/>
                                <Setter Property="Foreground" Value="#1A0C24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GTA 6 Top Settings Tab Style: Keeps TabItem.Foreground = White so tab content pages NEVER inherit dark text! -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="#42204E"
                                BorderBrush="#6E417B"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="16,6"
                                Margin="0,0,5,0"
                                TextElement.Foreground="#F0E6F6">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5C2D6B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#1A0C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem & DataGridCell High-Contrast Selection Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1"
                                TextElement.Foreground="#FFFFFF">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#542864"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#1A0C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#582A6A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
